{
  "hostUserId": {{p4Id}},
  "latitude": {{lat}},
  "longitude": {{lng}}
}

> {%
    client.global.set("soloParty4Id", response.body.data.id);
%}

### Queue Solo Party P1
POST {{baseUrl}}/ranked-parties/{{soloParty1Id}}/queue
Content-Type: application/json

{
  "userId": {{p1Id}},
  "latitude": {{lat}},
  "longitude": {{lng}},
  "startTime": "{{soloStartTime}}",
  "endTime": "{{soloEndTime}}"
}

### Queue Solo Party P2
POST {{baseUrl}}/ranked-parties/{{soloParty2Id}}/queue
Content-Type: application/json

{
  "userId": {{p2Id}},
  "latitude": {{lat}},
  "longitude": {{lng}},
  "startTime": "{{soloStartTime}}",
  "endTime": "{{soloEndTime}}"
}

### Queue Solo Party P3
POST {{baseUrl}}/ranked-parties/{{soloParty3Id}}/queue
Content-Type: application/json

{
  "userId": {{p3Id}},
  "latitude": {{lat}},
  "longitude": {{lng}},
  "startTime": "{{soloStartTime}}",
  "endTime": "{{soloEndTime}}"
}

### Queue Solo Party P4
POST {{baseUrl}}/ranked-parties/{{soloParty4Id}}/queue
Content-Type: application/json

{
  "userId": {{p4Id}},
  "latitude": {{lat}},
  "longitude": {{lng}},
  "startTime": "{{soloStartTime}}",
  "endTime": "{{soloEndTime}}"
}

### Wait around 60 seconds for MatchmakingQueueScheduler.
### Then poll Solo Party P1 until status is MATCHED.
GET {{baseUrl}}/ranked-parties/{{soloParty1Id}}

> {%
    if (response.body.data && response.body.data.matchedBookingId) {
        client.global.set("soloBookingId", response.body.data.matchedBookingId);
    }
%}

### Get created solo booking
GET {{baseUrl}}/bookings/{{soloBookingId}}

### P1 accepts solo match
POST {{baseUrl}}/bookings/{{soloBookingId}}/accept-match?userId={{p1Id}}
Authorization: Bearer {{p1Token}}

### P2 accepts solo match
POST {{baseUrl}}/bookings/{{soloBookingId}}/accept-match?userId={{p2Id}}
Authorization: Bearer {{p2Token}}

### P3 accepts solo match
POST {{baseUrl}}/bookings/{{soloBookingId}}/accept-match?userId={{p3Id}}
Authorization: Bearer {{p3Token}}

### P4 accepts solo match
POST {{baseUrl}}/bookings/{{soloBookingId}}/accept-match?userId={{p4Id}}
Authorization: Bearer {{p4Token}}

### Check solo booking after accepts
GET {{baseUrl}}/bookings/{{soloBookingId}}


### =========================================================
### 6. Optional post-match APIs
### Replace matchId manually from referee matches response if you want to submit result.
### =========================================================
@rankedBookingId = {{duoBookingId}}
### check in refeeren
POST {{baseUrl}}/bookings/{{rankedBookingId}}/check-in
Authorization: Bearer {{refereeToken}}
Content-Type: application/json

{
  "userId": {{refereeId}},
  "latitude": 20.978890,
  "longitude": 105.802197,
  "checkInMethod": "GPS"
}

### check in p1
POST {{baseUrl}}/bookings/{{rankedBookingId}}/check-in
Authorization: Bearer {{p1Token}}
Content-Type: application/json

{
  "userId": {{p1Id}},
  "latitude": 20.978890,
  "longitude": 105.802197,
  "checkInMethod": "GPS"
}

### check in p2
POST {{baseUrl}}/bookings/{{rankedBookingId}}/check-in
Authorization: Bearer {{p2Token}}
Content-Type: application/json

{
  "userId": {{p2Id}},
  "latitude": 20.978890,
  "longitude": 105.802197,
  "checkInMethod": "GPS"
}

### check in p3
POST {{baseUrl}}/bookings/{{rankedBookingId}}/check-in
Authorization: Bearer {{p3Token}}
Content-Type: application/json

{
  "userId": {{p3Id}},
  "latitude": 20.978890,
  "longitude": 105.802197,
  "checkInMethod": "GPS"
}

### Referee matches. Find the match id here.
GET {{baseUrl}}/referee/{{refereeId}}/matches
Authorization: Bearer {{refereeToken}}

### Submit result by ranked match id. Replace 0 with matchId from previous response.
@rankedMatchId = 74
POST {{baseUrl}}/referee/matches/{{rankedMatchId}}/result
Authorization: Bearer {{refereeToken}}
Content-Type: application/json

{
  "refereeUserId": {{refereeId}},
  "teamAScore": 11,
  "teamBScore": 8,
  "winningTeam": "A",
  "evidenceUrl": "https://example.com/evidence.mp4"
}

### Confirm result P1
POST {{baseUrl}}/bookings/{{rankedMatchId}}/confirm-result
Authorization: Bearer {{p1Token}}
Content-Type: application/json

{
  "playerUserId": {{p1Id}},
  "accepted": true
}

### Confirm result P2
POST {{baseUrl}}/bookings/{{rankedMatchId}}/confirm-result
Authorization: Bearer {{p2Token}}
Content-Type: application/json

{
  "playerUserId": {{p2Id}},
  "accepted": true
}

### Confirm result P3
POST {{baseUrl}}/bookings/{{rankedMatchId}}/confirm-result
Authorization: Bearer {{p3Token}}
Content-Type: application/json

{
  "playerUserId": {{p3Id}},
  "accepted": true
}

### Confirm result P4
POST {{baseUrl}}/bookings/{{duoBookingId}}/confirm-result
Authorization: Bearer {{p4Token}}
Content-Type: application/json

{
  "playerUserId": {{p4Id}},
  "accepted": true
}

### Get match result/Elo preview
GET {{baseUrl}}/bookings/{{rankedMatchId}}/result
